# ──────────────────────────────────────────────────────────────────
# LINEZHEETS PLATFORM — ENVIRONMENT VARIABLES
# Copy to .env and fill in all values before starting the server
# ──────────────────────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:4000

# ── Anthropic / Claude AI ────────────────────────────────────────────
# Get from: console.anthropic.com → API Keys
# Powers: AI SKU generation, pricing recommendations, description writing
ANTHROPIC_API_KEY=sk-ant-...

# ── Database (Supabase PostgreSQL) ──────────────────────────────────
# Get from: supabase.com → Project → Settings → Database → Connection string
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# ── JWT ─────────────────────────────────────────────────────────────
JWT_SECRET=your-super-long-random-secret-key-minimum-64-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ── Stripe ──────────────────────────────────────────────────────────
# Get from: dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_live_...          # Use sk_test_... for development
STRIPE_PUBLISHABLE_KEY=pk_live_...     # Use pk_test_... for development
STRIPE_WEBHOOK_SECRET=whsec_...        # From: Stripe → Webhooks → Signing secret

# Stripe subscription price IDs (create in Stripe dashboard → Products)
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_ANNUAL=price_...
STRIPE_PRICE_STUDIO_MONTHLY=price_...
STRIPE_PRICE_STUDIO_ANNUAL=price_...

# Platform commission (percentage, e.g. 3 = 3%)
PLATFORM_COMMISSION_RATE=3

# ── File Storage (Supabase Storage or AWS S3) ────────────────────────
STORAGE_PROVIDER=supabase           # supabase | s3

# Supabase Storage
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_SERVICE_KEY=eyJ...          # Service role key (NOT anon key)
SUPABASE_STORAGE_BUCKET=linezheets-media

# AWS S3 (alternative to Supabase Storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=linezheets-media

# ── Email (Resend or SMTP) ───────────────────────────────────────────
EMAIL_PROVIDER=smtp                  # smtp | resend | sendgrid
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_...
EMAIL_FROM=hello@linezheets.com
EMAIL_FROM_NAME=Linezheets

# ── App ─────────────────────────────────────────────────────────────
APP_NAME=Linezheets
APP_URL=https://linezheets.com
SUPPORT_EMAIL=support@linezheets.com

# Installment settings
MAX_INSTALLMENT_MONTHS=12
INSTALLMENT_INTEREST_RATE=0          # 0 = interest-free
MAX_ORDER_WITHOUT_VERIFICATION=50000 # USD, orders above need manual approval
